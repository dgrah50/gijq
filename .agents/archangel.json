{
  "version": 1,
  "gate": {
    "testFileGlobs": [
      "**/*_test.go"
    ],
    "testDataGlobs": [
      "**/testdata/**"
    ],
    "testBuildCmd": "go test -run=^$ ./...",
    "baseTestCmd": "go test -count=1 ./...",
    "testCmd": "go test -race -count=1 ./...",
    "protectedPaths": [
      "go.mod",
      "go.sum",
      "go.work",
      "go.work.sum",
      "vendor/**",
      "scripts/**",
      "Makefile",
      "GNUmakefile",
      ".goreleaser*",
      ".golangci*"
    ]
  },
  "requiredChecks": [
    "Gate",
    "Test (ubuntu-latest)",
    "Test (macos-latest)"
  ],
  "review": {
    "rubric": "Pay close attention to UTF-8/rune vs byte slicing, Bubble Tea v2 model immutability, and cancellation safety in background goroutines."
  },
  "scouts": [
    {
      "name": "bug-hunt",
      "schedule": "daily",
      "maxProposals": 2,
      "promotion": "auto",
      "skills": [
        "general/bug-hunt",
        "general/error-handling",
        "general/input-validation",
        "go/*"
      ]
    }
  ],
  "landing": {
    "bugfix": "autonomous"
  },
  "escalations": {
    "factoryRetry": "once"
  },
  "fleetScouts": {
    "optOut": [
      "fleet-pr-miner"
    ]
  }
}
